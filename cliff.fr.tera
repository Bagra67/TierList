{# Section de CHANGELOG.fr.md générée par scripts/prepare-release.sh (git-cliff --body-file).
   Mêmes groupes que le body de cliff.toml, titres en français. Les lignes reprennent les sujets
   de commit (en anglais) : elles sont traduites à la relecture de la PR de préparation. -#}
## [{{ version | trim_start_matches(pat="v") }}] - {{ timestamp | date(format="%Y-%m-%d") }}
{% for group, commits in commits | group_by(attribute="group") %}
{%- set title = group | striptags | trim %}
### {% if title == "Features" %}Fonctionnalités{% elif title == "Bug fixes" %}Corrections{% elif title == "Performance" %}Performances{% elif title == "Refactoring" %}Refactorisation{% elif title == "Chores" %}Maintenance{% elif title == "Other" %}Autres{% else %}{{ title }}{% endif %}
{% for commit in commits %}
- {% if commit.breaking %}**INCOMPATIBLE** {% endif %}{% if commit.scope %}{{ commit.scope }} : {% endif %}{{ commit.message | split(pat="\n") | first | trim }}
{%- endfor %}
{% endfor %}
