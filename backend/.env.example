# Copiez ce fichier en .env (non commité) puis remplacez les valeurs.
# Il est lu à la fois par le backend (app/core/config.py)
# et par le conteneur PostgreSQL (compose.yaml, à la racine du dépôt).

POSTGRES_USER=tierlist
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=tierlist

# Adresse de la base vue depuis le backend (le port est publié sur 127.0.0.1)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Délai maximal pour se connecter à la base, en secondes (défaut : 3)
# DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Niveau des logs de l'application : DEBUG, INFO, WARNING, ERROR ou CRITICAL (défaut : INFO)
LOG_LEVEL=INFO

# Authentification (docs/technical/authentication.md)
# Clé de signature des access tokens (JWT), 32 caractères minimum, différente par environnement.
# Générer : uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=remplacez-moi-par-une-cle-aleatoire-de-32-caracteres-minimum
# Durées de vie (défauts : 15 minutes et 30 jours)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Longueur minimale du mot de passe à l'inscription (défaut : 8, au plus 128)
# PASSWORD_MIN_LENGTH=8
# Compte créé avec Google : âge maximal de la connexion pour supprimer le compte, en minutes (défaut : 5)
# RECENT_AUTHENTICATION_MAX_AGE_MINUTES=5
# Validité du lien de confirmation de l'adresse email, en heures (défaut : 24)
# EMAIL_VERIFICATION_TTL_HOURS=24
# Validité du lien de réinitialisation du mot de passe, en minutes (défaut : 30)
# PASSWORD_RESET_TTL_MINUTES=30
# Délai minimal entre deux emails du même type pour un compte, en secondes (défaut : 60)
# EMAIL_COOLDOWN_SECONDS=60
# Cookie du refresh token réservé à HTTPS (défaut : true). false en local, servi en HTTP.
AUTH_COOKIE_SECURE=false
# Chemin du cookie de refresh : les routes d'authentification, sous l'API servie sur /api (défaut : /api/auth)
# AUTH_COOKIE_PATH=/api/auth

# Templates (docs/technical/templates.md)
# Jours pendant lesquels un template supprimé reste en base avant d'être purgé définitivement (défaut : 30)
# DELETED_TEMPLATE_RETENTION_DAYS=30

# Salles (docs/technical/rooms.md)
# Timer par item d'une nouvelle salle, en secondes, entre 5 et 300 (défaut : 30)
# ROOM_DEFAULT_TIMER_SECONDS=30
# Cooldown final d'une nouvelle salle, en secondes, entre 10 et 600 (défaut : 60)
# ROOM_DEFAULT_COOLDOWN_SECONDS=60
# Validité du lien perso d'un invité, en jours, 30 au plus (défaut : 30)
# GUEST_LINK_TTL_DAYS=30
# Chemin des routes des salles (sous /api), base du cookie des invités (défaut : /api/rooms)
# ROOM_COOKIE_PATH=/api/rooms
# Canal temps réel (docs/technical/realtime.md), en secondes : intervalle du ping (défaut : 10),
# délai du pong (défaut : 5), délai de grâce avant « déconnecté » (défaut : 3), délai du
# message d'authentification (défaut : 5)
# ROOM_HEARTBEAT_INTERVAL_SECONDS=10
# ROOM_HEARTBEAT_TIMEOUT_SECONDS=5
# ROOM_PRESENCE_GRACE_SECONDS=3
# ROOM_AUTH_TIMEOUT_SECONDS=5
# Fermeture automatique : une salle ouverte où personne n'est connecté, sans changement depuis ce
# délai en heures, est fermée (défaut : 24), par un balayage lancé toutes les N minutes (défaut : 15)
# ROOM_INACTIVITY_HOURS=24
# ROOM_INACTIVITY_SWEEP_MINUTES=15

# Images des tuiles (docs/technical/images.md)
# Taille maximale d'une image envoyée, en octets ; à aligner sur la limite du reverse proxy (défaut : 10485760, soit 10 Mio)
# IMAGE_UPLOAD_MAX_BYTES=10485760
# Nombre maximal de pixels de l'image décodée, contre les bombes de décompression (défaut : 40000000)
# IMAGE_MAX_SOURCE_PIXELS=40000000
# Nombre maximal d'images envoyées par un compte sur une heure glissante (défaut : 120)
# IMAGE_UPLOADS_PER_HOUR_MAX=120
# Jours pendant lesquels une image qu'aucune tuile n'utilise est gardée avant d'être effacée par
# scripts/purge_unused_images.py (défaut : 7)
# UNUSED_IMAGE_RETENTION_DAYS=7
# Stockage S3 des images. Valeurs ci-dessous : SeaweedFS (compose.yaml), dont l'interface
# http://localhost:8888 montre les images (dossier buckets/). En production, le fournisseur S3.
# Adresse de l'API S3 ; à retirer pour AWS S3
IMAGE_S3_ENDPOINT_URL=http://127.0.0.1:8333
# Bucket et région (défauts : tierlist-images et us-east-1)
# IMAGE_S3_BUCKET=tierlist-images
# IMAGE_S3_REGION=us-east-1
# Clés d'accès (celles de seaweedfs/s3.json en développement) ; sans elles, boto3 cherche ses
# identifiants habituels (variables AWS_*, rôle de la machine)
IMAGE_S3_ACCESS_KEY_ID=tierlist-dev
IMAGE_S3_SECRET_ACCESS_KEY=tierlist-dev-not-a-secret
# Délai des appels au stockage, en secondes (défaut : 10)
# IMAGE_S3_TIMEOUT_SECONDS=10
# Adresse publique des images (CDN ou bucket) ; l'URL d'une image est cette adresse suivie de sa
# clé (défaut : le bucket SeaweedFS ci-dessous)
# IMAGE_PUBLIC_BASE_URL=http://127.0.0.1:8333/tierlist-images

# Connexion avec Google (facultatif ; docs/technical/authentication.md, « Configurer Google »).
# Sans ces deux valeurs, le bouton « Continuer avec Google » indique que le service est indisponible.
# GOOGLE_CLIENT_ID=votre-id-client.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=votre-secret-client
# Doit figurer dans les « URI de redirection autorisés » du client Google (défaut ci-dessous)
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Temps laissé sur la page de Google avant que la tentative expire, en minutes (défaut : 10)
# GOOGLE_LOGIN_ATTEMPT_TTL_MINUTES=10
# Délai des appels vers Google, en secondes (défaut : 10)
# GOOGLE_HTTP_TIMEOUT_SECONDS=10

# Envoi des emails (docs/technical/emails.md). Sans SMTP_HOST, aucun email ne part (l'envoi est journalisé).
# Valeurs ci-dessous : Mailpit (compose.yaml), qui affiche les emails sur http://localhost:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# STARTTLS (défaut : true) ; false seulement pour Mailpit, en local
SMTP_STARTTLS=false
# Identifiants du fournisseur SMTP en production (Mailpit n'en demande pas)
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Délai des échanges avec le serveur SMTP, en secondes (défaut : 10)
# SMTP_TIMEOUT_SECONDS=10
# Expéditeur ; en production, son domaine doit être autorisé chez le fournisseur (SPF, DKIM)
# EMAIL_FROM=TierList <no-reply@localhost>
# Adresse publique de l'application (frontend et API, même origine), base des liens envoyés par email
# et seule origine acceptée par le canal temps réel (défaut ci-dessous)
# FRONTEND_BASE_URL=http://localhost:5173

# Déploiement (docs/technical/deployment.md)
# Build du frontend servi par FastAPI ; absent en développement, où Vite sert le frontend
# (défaut : frontend_dist/ à côté de backend/)
# FRONTEND_DIST=../frontend_dist
# Version qui tourne, renvoyée par /api/health : écrite par le déploiement (défaut : dev)
# APP_RELEASE=dev
# Purges de nuit dans le processus (templates supprimés, images inutilisées), et leur heure UTC
# (défauts : true, 3)
# MAINTENANCE_ENABLED=true
# MAINTENANCE_HOUR_UTC=3
